# Add real values only to backend/.env. Never commit that file.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Leave SUPABASE_DB_URL blank to keep using local SQLite. To use Supabase,
# paste the Session pooler connection string from Supabase Dashboard > Connect.
# This is a database password, not a Supabase project URL or browser API key.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./customai_studio.db
JWT_SECRET=your_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
